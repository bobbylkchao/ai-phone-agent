{
  "name": "ai-phone-agent",
  "version": "0.0.1",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "compile": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "npm run compile && node ./dist/index.js",
    "build": "npm run compile",
    "dev": "nodemon",
    "lint": "eslint --config ./eslint.config.mjs src --fix",
    "lint:ci": "eslint --config ./eslint.config.mjs src --max-warnings 0",
    "format": "prettier --config .prettierrc \"src/**/*.ts\" \"jest.config.cjs\" --write",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --coverage --runInBand",
    "version": "npx standard-version --skip.tag --skip.commit --release-as patch"
  },
  "keywords": [
    "ai-phone-agent",
    "openai",
    "realtime",
    "amazon-connect",
    "voice-agent",
    "pstn",
    "sip"
  ],
  "author": "",
  "license": "MIT",
  "description": "OpenAI Realtime phone agent server for Amazon Connect SIP",
  "dependencies": {
    "@aws-sdk/client-connect": "^3.1131.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "ws": "^8.21.3",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.2",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsc-alias": "^1.9.5",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
