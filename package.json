{
  "name": "ai-phone-agent",
  "version": "0.0.1",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "compile": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "npm run compile && node ./dist/index.js",
    "build": "npm run compile",
    "dev": "nodemon",
    "lint": "eslint --config ./eslint.config.mjs src --fix",
    "lint:ci": "eslint --config ./eslint.config.mjs src --max-warnings 0",
    "format": "prettier --config .prettierrc \"src/**/*.ts\" \"jest.config.cjs\" --write",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --coverage --runInBand",
    "version": "npx standard-version --skip.tag --skip.commit --release-as patch"
  },
  "keywords": [
    "ai-phone-agent",
    "openai",
    "realtime",
    "amazon-connect",
    "voice-agent",
    "pstn",
    "sip"
  ],
  "author": "",
  "license": "MIT",
  "description": "OpenAI Realtime phone agent server for Amazon Connect SIP",
  "dependencies": {
    "@aws-sdk/client-connect": "^3.1175.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "tsc-alias": "^1.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "overrides": {
    "glob": "^14.0.6",
    "minimatch": "^11.0.9"
  }
}
